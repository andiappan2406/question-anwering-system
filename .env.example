# Supabase PostgreSQL Connection URL
# Example: postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Optional Supabase REST endpoint
SUPABASE_URL="https://your-project.supabase.co"

# Fallback local SQLite file path
FALLBACK_SQLITE_PATH="data/college.db"

# Application Environment (production / development)
APP_ENV="production"
